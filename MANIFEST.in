# Files to include in the source distribution beyond what setuptools infers.
include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include pyproject.toml
include adder/py.typed
recursive-include adder/pricing/data *.json
# The agent definitions activation installs; see pyproject's package-data.
recursive-include adder/decide/agents *.md
recursive-include adder/decide/skills *.md
include adder/decide/hooks/hooks.json
recursive-include tests *.py
recursive-include docs *.md
# What the shipped tests read. `tests/repo` checks the plugin manifest, the two
# launchers its hooks run and the governance files, so an sdist that carried
# the tests without these failed its own suite on a clean extract. They are
# not plumbing like `.claude/`: `.claude-plugin/` is the plugin itself.
include CLAUDE.md
include CODE_OF_CONDUCT.md
recursive-include .claude-plugin *.json
include bin/adder
include scripts/adder

# Never ship repo plumbing or caches.
prune .github
prune .claude
prune .pytest_cache
prune .ruff_cache
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
