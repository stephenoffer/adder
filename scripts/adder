#!/usr/bin/env bash
# Launcher so adder works from a git checkout, with or without `pip install`.
# All command dispatch, help, and error handling live in adder/cli.py — this
# script only resolves the interpreter and puts the repo on PYTHONPATH.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(dirname "$here")"
export PYTHONPATH="$repo${PYTHONPATH:+:$PYTHONPATH}"

py="${ADDER_PYTHON:-}"
if [[ -z "$py" ]]; then
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then py="$candidate"; break; fi
  done
fi
if [[ -z "$py" ]]; then
  echo "adder: no python3 on PATH. Install Python 3.10+ or set ADDER_PYTHON." >&2
  exit 127
fi

"$py" - <<'PYCHECK' || exit 1
import sys
if sys.version_info < (3, 10):
    sys.stderr.write(
        f"adder: needs Python 3.10+, found {sys.version.split()[0]}. "
        "Set ADDER_PYTHON to a newer interpreter.\n"
    )
    raise SystemExit(1)
PYCHECK

exec "$py" -m adder "$@"
